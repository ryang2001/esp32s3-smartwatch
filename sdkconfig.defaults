# Target chip
CONFIG_IDF_TARGET="esp32s3"

# CPU frequency: 240 MHz for maximum UI responsiveness
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# Flash: 16MB, QIO mode, 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# OTA: rollback to previous slot when new image fails self-test
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Octal PSRAM, 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS runtime stats (for CPU usage monitoring)
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# LVGL
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
